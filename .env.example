# Copy to ".env" (same folder as manage.py) and fill in.
# On PythonAnywhere you can also set these in the Web tab, but a .env file is simpler.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-50-random-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com
DJANGO_TIME_ZONE=Europe/Berlin

# Used to build the accept / decline links inside emails. No trailing slash.
SITE_BASE_URL=https://yourname.pythonanywhere.com

# How long an accept / decline link keeps working.
DECISION_LINK_MAX_AGE_DAYS=30

# Turn on once the site is genuinely HTTPS-only (PythonAnywhere: "Force HTTPS").
# Raise HSTS in steps - 60, then 3600, then 31536000 - it is hard to undo.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600

# --- Email ----------------------------------------------------------------
# Leave EMAIL_HOST empty to print emails to the console instead of sending them.
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (PythonAnywhere free accounts cannot make outbound SMTP connections; a paid
#  account can, or use an allowlisted API-based provider.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=salon@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Hair Salon <salon@example.com>

# --- Database (optional) --------------------------------------------------
# Leave DB_NAME empty to use SQLite, which is fine for a single salon.
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=yourname$salon
# DB_USER=yourname
# DB_PASSWORD=
# DB_HOST=yourname.mysql.pythonanywhere-services.com

# --- Google OAuth (only for `manage.py connect_google`) -------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
