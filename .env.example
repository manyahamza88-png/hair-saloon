# Copy to ".env" (same folder as manage.py) and fill in.
# On PythonAnywhere you can also set these in the Web tab, but a .env file is simpler.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-50-random-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com
DJANGO_TIME_ZONE=Europe/Berlin

# Used to build the accept / decline links inside emails. No trailing slash.
SITE_BASE_URL=https://yourname.pythonanywhere.com

# How long an accept / decline link keeps working.
DECISION_LINK_MAX_AGE_DAYS=30

# Turn on once the site is genuinely HTTPS-only (PythonAnywhere: "Force HTTPS").
# Raise HSTS in steps - 60, then 3600, then 31536000 - it is hard to undo.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600

# --- Email ---------------------------------------------------------------
# By default there is NOTHING to configure here.
#
# Booking emails are sent through the Gmail API of the Google account you
# connect at /manage/google/ -- the same account used for the calendar. No SMTP
# host, no app password, and it works on hosts that block outbound SMTP
# (PythonAnywhere's free plan among them).
#
# Only set these if you would rather use your own SMTP server instead. Setting
# EMAIL_HOST switches the whole app over to SMTP.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=salon@example.com
# EMAIL_HOST_PASSWORD=your-app-password

# Display name on outgoing mail. With the Gmail route the address is always the
# connected account, whatever you put here.
DEFAULT_FROM_EMAIL=Hair Salon <salon@example.com>

# Print emails to the console instead of sending, when no Google account is
# connected. Defaults to on in development, off in production.
# EMAIL_FALLBACK_TO_CONSOLE=True

# --- Database (optional) --------------------------------------------------
# Leave DB_NAME empty to use SQLite, which is fine for a single salon.
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=yourname$salon
# DB_USER=yourname
# DB_PASSWORD=
# DB_HOST=yourname.mysql.pythonanywhere-services.com

# --- Google OAuth (only for `manage.py connect_google`) -------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
